# Copy to .env for local runs. On GitHub, add each as a repository secret instead.
GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free)
GROQ_API_KEY=          # https://console.groq.com/keys (free, fallback LLM)
PEXELS_API_KEY=        # https://www.pexels.com/api/ (optional; new keys currently paused)
PIXABAY_API_KEY=       # https://pixabay.com/api/docs/ (free)
YT_CLIENT_ID=          # from scripts/get_youtube_token.py
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
BOT_CONTACT=           # optional: your email or channel URL (Wikimedia asks bots for contact info)
